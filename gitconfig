[alias]
  co = checkout
  br = branch
  ci = commit
  cl = clone
  st = status
  a = add
  pu = push
  pl = pull
  d = diff
  cp = cherry-pick
  rb = rebase
[core]
	editor = nvim
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[pull]
	rebase = true
[rebase]
  autoStash = true
[init]
	defaultBranch = main
	templatedir = " "
[http]
	sslVerify = false
[push]
  autoSetupRemote = true

[includeIf "gitdir:~/projects/work/"]
  path = ~/projects/work/.gitconfig

[includeIf "gitdir:~/projects/myown/"]
  path = ~/projects/myown/.gitconfig
